APP_NAME="Lusa Gestion"
APP_ENV=production
# Generar con: php artisan key:generate
APP_KEY=
# Nunca dejar en true en el servidor: expone trazas y variables
APP_DEBUG=false
# Usar http:// mientras el servidor no tenga certificado (php artisan serve no soporta HTTPS)
APP_URL=http://100.97.235.20:5080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=transporte_db
# Usar un usuario propio de la app con permisos limitados, no "postgres"
DB_USERNAME=lusa_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true solo cuando el sitio se sirva por HTTPS; con HTTP la sesion no se guarda (error 419 / no deja iniciar sesion)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Hashids: sal para ofuscar ids en URLs y API (cadena larga aleatoria)
HASHIDS_SALT=
HASHIDS_MIN_LENGTH=10

# Firma HMAC de la app movil (dejar vacio para desactivar). Debe coincidir con la app.
APP_SIGNATURE_SECRET=
APP_SIGNATURE_WINDOW=300
# Vigencia del token de la app (minutos)
APP_TOKEN_MINUTES=720
# Una unidad solo puede estar dentro de un departamento a la vez
ESTANCIA_UNICA_POR_UNIDAD=true

# Proxys de confianza (ip del nginx / balanceador)
TRUSTED_PROXIES=127.0.0.1

# Administrador inicial (UsuarioSeeder). Si se deja vacio se genera una contrasena aleatoria.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=
